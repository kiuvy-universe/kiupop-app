# KiuPop — configuración LOCAL de ejemplo. `make setup` la copia a .env (sin sobrescribir).
# Valores ficticios exclusivamente de desarrollo. Nunca pongas secretos reales aquí ni en .env.
# Comentarios siempre en su propia línea (Make no recorta comentarios al final del valor).

# --- Docker Compose (infra/compose.yaml) -----------------------------------
# local | development. MOCK_MODE solo se permite en estos dos.
APP_ENV=local
APP_VERSION=dev
POSTGRES_DB=kiupop
POSTGRES_USER=kiupop
POSTGRES_PASSWORD=kiupop_local_only
# Publicado en 127.0.0.1:5433 para no chocar con un PostgreSQL local en 5432.
POSTGRES_HOST_PORT=5433
# Publicado en 127.0.0.1:8080.
API_HOST_PORT=8080
# Habilita /api/v1/demo/*. Falla cerrado si APP_ENV no es local/development.
MOCK_MODE=true
# No existe adaptador todavía: true hace fallar el arranque a propósito.
KIUVY_INTEGRATION_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Creación anónima de tiendas (POC). Falla cerrado fuera de local/development.
STORE_SIGNUP_ENABLED=true

# --- KiuPop AI (opcional) ------------------------------------------------------
# Requiere AI_ENABLED=true Y una clave. Sin clave, la app funciona y el botón lo explica.
# Pon la clave SOLO en tu .env local (está en .gitignore). Nunca en Git ni en Flutter.
AI_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Kiu (agente): niveles del ModelRouter y tope de costo IA por tienda (micro-USD; 60000 = US$0,06).
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_SMART=claude-sonnet-5-5
AI_MODEL_PREMIUM=claude-opus-5-5
AI_SESSION_BUDGET_MICROS=60000
# Topes diarios de costo IA (micro-USD): por usuario (todas sus sesiones) y global. 0 = sin tope.
AI_USER_DAILY_BUDGET_MICROS=300000
AI_GLOBAL_DAILY_BUDGET_MICROS=5000000

# --- Identidad (proveedor exclusivo de KiuPop, nunca el de Kiuvy) -----------------
# emulator = Firebase Auth Emulator local (proyecto demo-kiupop, sin cuenta real).
# Falla cerrado fuera de local/development. firebase = proyecto real de KiuPop.
AUTH_PROVIDER=emulator
FIREBASE_PROJECT_ID=demo-kiupop
# Publicado en 127.0.0.1:9199 (9099 lo usa el emulador de Kiuvy).
AUTH_EMULATOR_HOST_PORT=9199
# Facebook queda apagado hasta tener la app de Meta y credenciales de prueba.
FACEBOOK_AUTH_ENABLED=false

# --- Enlaces públicos y pagos de prueba ------------------------------------------
PUBLIC_API_BASE=http://localhost:8080
PUBLIC_WEB_BASE=http://localhost:3000
# Checkout simulado (MockPaymentGateway). Nunca cobra dinero real. Solo local/development.
PAYMENTS_TEST_CHECKOUT=true
AGENT_WORKERS=4
# Kiu diagnostica la necesidad (canal, dolor) y propone un plan antes de construir.
# false = flujo original de Kiu, sin cambios (rollback inmediato).
KIU_DISCOVERY_ENABLED=true

# Paywall del quiz funnel: publicar una tienda requiere el plan de US$5/mes por
# tienda activa. Hoy SOLO en modo prueba (no se cobra dinero real; necesita
# PAYMENTS_TEST_CHECKOUT=true). false = publicar es gratis, como antes.
# Un valor inválido hace fallar el arranque (falla cerrado).
PAYWALL_ENABLED=true

# --- API ejecutada en el host (make api-host) --------------------------------
API_PORT=8080

# --- Flutter Web (se pasa con --dart-define; el navegador nunca lee .env) ------
API_BASE_URL=http://localhost:8080
WEB_PORT=3000
