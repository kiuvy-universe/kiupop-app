  "messages": [
    {
      "id": 409,
      "role": "kiu",
      "text": "¡Hola! Soy Kiu. Contame qué hace tu negocio y yo me encargo de crear tu tienda. Escribime con tus palabras: qué vendés, cómo se llama y cómo te gustaría que se vea.",
      "meta": {
